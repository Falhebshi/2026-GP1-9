__pycache__/
*.pyc

.venv/
venv/

.env

.ipynb_checkpoints/

.DS_Store
Thumbs.db

# RCRC sample data - publication permission pending
/data/raw/rcrc_sample/
/data/processed/rcrc_sample/
.pytest_cache/

# SUMO Stress Test v2 generated results
/simulation/outputs/tests/stress_test_v2/

# Movement Smoke Test generated results
/simulation/outputs/tests/movement_smoke/

# SUMO demand generation output (regenerated from the demand records and seed)
/simulation/outputs/baseline*/
/simulation/outputs/tests/sumo_demand_check/

# KPI measurement check output (regenerated by the check)
/simulation/outputs/tests/kpi_measurement_check/

# Fast run of the live loop (simulation/scripts/tests/run_live_fast.py)
/simulation/outputs/tests/live_fast/

# Stored days of the historical analysis (rebuilt by run_history.py; about 2.5 MB a day)
/data/history/
# Trends page files: built from private RCRC data by backend/analytics/trends_page.py
# on the computer that runs the history; never committed (docs/kpi_engine.md, section 17)
/frontend/public/data/*/history/

# Generated synthetic traffic database
/data/synthetic_traffic/*.db
/data/synthetic_traffic/*.db-*

# OpenStreetMap download for the network map (rebuild with the Overpass query)
/data/raw/network/

# Network map server database (uvicorn jaadah.network_congestion.server:app):
# shaped by the RCRC measures
/data/network_congestion/

# Network map OD matrices: rebuilt from the code (python -m jaadah.network_congestion.trips)
/data/processed/network/od_matrices.npz
/data/processed/network/od_sensitivity.npz
/data/processed/network/assigned_flows.json
/data/processed/network/assigned_flows_friday.json

# Accounts database (backend/accounts/storage.py): holds password hashes
/data/accounts/

# Live update loop (simulation/scripts/run_live.py): the chain's working files and
# the page's live outputs, rebuilt as the loop runs; never committed
/simulation/outputs/live/
/frontend/public/data/*/live/
